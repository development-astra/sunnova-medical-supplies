# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sunnova:sunnova_pass@localhost:5432/sunnova_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookies ─────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── DigitalOcean Spaces ─────────────────────────────────────────────────────
DIGITALOCEAN_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DIGITALOCEAN_SPACES_REGION=nyc3
DIGITALOCEAN_SPACES_BUCKET=sunnova-assets
DIGITALOCEAN_SPACES_ACCESS_KEY=your_spaces_access_key
DIGITALOCEAN_SPACES_SECRET_KEY=your_spaces_secret_key
DIGITALOCEAN_SPACES_CDN_URL=https://sunnova-assets.nyc3.cdn.digitaloceanspaces.com

# ─── Stripe (abstraction ready — no live keys needed yet) ────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@sunnovamedical.com
RESEND_API_KEY=re_placeholder
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Admin Seed ──────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@sunnovamedical.com
ADMIN_SEED_PASSWORD=SunnovaAdmin2026!
