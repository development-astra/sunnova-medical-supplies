# Copy this file to .env and fill in your real values.  .env is git-ignored.

# ---- Database (REQUIRED) --------------------------------------------------
# PostgreSQL only — there is no SQLite fallback.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sunnova

# ---- Flask ----------------------------------------------------------------
# A throwaway dev key is used automatically when FLASK_DEBUG=1.
# REQUIRED when FLASK_DEBUG=0 (production): set a long random string.
# SECRET_KEY=change-me-to-a-long-random-string
# FLASK_DEBUG=1

# ---- Email (optional; leave unset and emails print to the console) --------
# MAIL_SERVER=smtp.yourprovider.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@yourprovider.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_DEFAULT_SENDER=Sunnova Medical Supplies <no-reply@sunnovamedical.com>
